{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "17576027366666078278"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "germanywestcentral"
    },
    "adminUsername": {
      "type": "string",
      "metadata": {
        "description": "The name of the Administrator of the new VM and Domain"
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "The password for the Administrator account of the new VM and Domain"
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D4s_v5"
    },
    "imagePublisher": {
      "type": "string",
      "defaultValue": "MicrosoftWindowsDesktop"
    },
    "imageOffer": {
      "type": "string",
      "defaultValue": "Windows-11"
    },
    "imageSKU": {
      "type": "string",
      "defaultValue": "win11-23h2-pro",
      "allowedValues": [
        "win11-22h2-pro",
        "win11-23h2-pro"
      ]
    },
    "numberOfInstances": {
      "type": "int",
      "defaultValue": 1
    },
    "networkInterfaceName": {
      "type": "string",
      "defaultValue": "nic"
    },
    "osdiskname_prd": {
      "type": "string",
      "defaultValue": "prd_osdisk"
    },
    "datadiskname_prd": {
      "type": "string",
      "defaultValue": "vmprd_datadisk"
    }
  },
  "variables": {
    "nsgrules": {
      "securityrules": [
        {
          "name": "IN_Ping_ALLOW",
          "properties": {
            "access": "Allow",
            "description": "Allow PING from VNET",
            "destinationAddressPrefix": "VirtualNetwork",
            "destinationPortRange": "*",
            "direction": "inbound",
            "priority": 300,
            "protocol": "Icmp",
            "sourceAddressPrefix": "VirtualNetwork",
            "sourcePortRange": "*"
          }
        }
      ]
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-01-01",
      "name": "networkSecurityGroup",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": "[variables('nsgrules').securityrules]"
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-05-01",
      "name": "natGatewayPublicIP",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Network/natGateways",
      "apiVersion": "2023-05-01",
      "name": "natGateway",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIpAddresses": [
          {
            "id": "[resourceId('Microsoft.Network/publicIPAddresses', 'natGatewayPublicIP')]"
          }
        ],
        "idleTimeoutInMinutes": 4
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', 'natGatewayPublicIP')]"
      ]
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-05-01",
      "name": "vpnGatewayPublicIP",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-05-01",
      "name": "Vnet03",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.3.0.0/16"
          ]
        },
        "subnets": [],
        "enableDdosProtection": false,
        "enableVmProtection": true
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', 'Vnet03', 'serversubnet')]",
      "properties": {
        "addressPrefix": "10.3.0.0/24",
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'networkSecurityGroup')]"
        },
        "natGateway": {
          "id": "[resourceId('Microsoft.Network/natGateways', 'natGateway')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/natGateways', 'natGateway')]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'networkSecurityGroup')]",
        "[resourceId('Microsoft.Network/virtualNetworks', 'Vnet03')]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', 'Vnet03', 'GatewaySubnet')]",
      "properties": {
        "addressPrefix": "10.3.1.0/27"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'Vnet03', 'serversubnet')]",
        "[resourceId('Microsoft.Network/virtualNetworks', 'Vnet03')]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworkGateways",
      "apiVersion": "2023-05-01",
      "name": "vpnGateway",
      "location": "[parameters('location')]",
      "properties": {
        "gatewayType": "Vpn",
        "vpnType": "RouteBased",
        "sku": {
          "name": "VpnGw1",
          "tier": "VpnGw1"
        },
        "ipConfigurations": [
          {
            "name": "vpnGatewayIpConfig",
            "properties": {
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', 'vpnGatewayPublicIP')]"
              },
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'Vnet03', 'GatewaySubnet')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'Vnet03', 'GatewaySubnet')]",
        "[resourceId('Microsoft.Network/publicIPAddresses', 'vpnGatewayPublicIP')]"
      ]
    },
    {
      "copy": {
        "name": "nicNameprd",
        "count": "[length(range(0, parameters('numberOfInstances')))]"
      },
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2020-11-01",
      "name": "[format('client-{0}{1}', parameters('networkInterfaceName'), range(0, parameters('numberOfInstances'))[copyIndex()])]",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'Vnet03', 'serversubnet')]"
              },
              "primary": true,
              "privateIPAddressVersion": "IPv4"
            }
          }
        ],
        "dnsSettings": {
          "dnsServers": []
        },
        "enableAcceleratedNetworking": false,
        "enableIPForwarding": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'Vnet03', 'serversubnet')]",
        "[resourceId('Microsoft.Network/virtualNetworks', 'Vnet03')]"
      ]
    },
    {
      "copy": {
        "name": "serverprd",
        "count": "[length(range(0, parameters('numberOfInstances')))]"
      },
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2020-12-01",
      "name": "[format('client{0}', range(0, parameters('numberOfInstances'))[copyIndex()])]",
      "location": "[parameters('location')]",
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "osProfile": {
          "computerName": "[format('win11client-{0}', range(0, parameters('numberOfInstances'))[copyIndex()])]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": {
            "enableAutomaticUpdates": true,
            "provisionVMAgent": true
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "[parameters('imagePublisher')]",
            "offer": "[parameters('imageOffer')]",
            "sku": "[parameters('imageSKU')]",
            "version": "latest"
          },
          "osDisk": {
            "name": "[format('{0}{1}', parameters('osdiskname_prd'), range(0, parameters('numberOfInstances'))[copyIndex()])]",
            "caching": "None",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Premium_LRS"
            }
          },
          "dataDisks": [
            {
              "name": "[format('{0}{1}', parameters('datadiskname_prd'), range(0, parameters('numberOfInstances'))[copyIndex()])]",
              "diskSizeGB": 128,
              "lun": 0,
              "createOption": "Empty"
            }
          ]
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', format('client-{0}{1}', parameters('networkInterfaceName'), range(0, parameters('numberOfInstances'))[range(0, parameters('numberOfInstances'))[copyIndex()]]))]"
            }
          ]
        }
      },
      "dependsOn": [
        "nicNameprd"
      ]
    }
  ]
}